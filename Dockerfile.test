# Official multi-architecture Node 26 LTS image; update this digest deliberately.
FROM node:26-bookworm@sha256:a546d3f8acd2af4382668a7e6acd3bc4418e6a27478373e3246f8162f5181509
RUN mkdir -p '/app/HeloScrum with spaces' && chown -R node:node /app
WORKDIR /app/HeloScrum with spaces
USER node
COPY --chown=node:node package.json package-lock.json ./
COPY --chown=node:node scripts/setup-pty.mjs ./scripts/setup-pty.mjs
ENV npm_config_jobs=2
RUN npm ci --no-audit --no-fund
COPY --chown=node:node . .
# Release checks need an index, not the user's actual Git history or credentials.
RUN git init --quiet --initial-branch=main
ENV CI=true TZ=UTC
CMD ["node", "scripts/platform-check.mjs"]
